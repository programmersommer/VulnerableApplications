@using WorkshopApp.ViewModels

@model HomeViewModel

<div class="form-group row">
    <div class="col-12">
        <p>We’d love to hear from you — please feel free to leave a comment!:</p>
    </div>
    @foreach (var item in Model.Article.Comments)
    {
        <div class="col-12">
            <div class="border border-info p-2">
                <p>@item.Author @item.Created</p>
                <p>@item.Message</p>
            </div>
        </div>
    }
</div>